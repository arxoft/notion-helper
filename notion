# ---------------------------------------------------------------------------
# Main dispatcher
# ---------------------------------------------------------------------------
require_deps

COMMAND="${1:-help}"
shift || true

if [[ "$COMMAND" != "help" && "$COMMAND" != "--help" && "$COMMAND" != "-h" ]]; then
  # bootstrap --help, rules, and dbs are allowed without .env.notion / a valid DB ID
  if [[ "$COMMAND" == "bootstrap" && $# -gt 0 && ( "$1" == "--help" || "$1" == "-h" || "$1" == "help" ) ]]; then
    true
  elif [[ "$COMMAND" == "rules" || "$COMMAND" == "dbs" ]]; then
    true
  else
    require_env
  fi
fi

case "$COMMAND" in
  tasks)
    if [[ $# -eq 0 ]]; then
      cmd_tasks_list
    elif [[ "$1" =~ ^[0-9]+$ ]]; then
      cmd_task_detail "$1"
    elif [[ "$1" == "--filter" || "$1" == "--sort" ]]; then
      cmd_tasks_list "$@"
    else
      die "Unknown argument for 'tasks': $1"
    fi
    ;;
  comment)
    if [[ $# -lt 2 ]]; then die "Usage: ./notion comment <No.> \"text\""; fi
    cmd_add_comment "$1" "$2"
    ;;
  update)
    if [[ $# -lt 3 ]]; then die "Usage: ./notion update <No.> <property> <value>"; fi
    cmd_update "$1" "$2" "$3"
    ;;
  create)
    cmd_create "$@"
    ;;
  open)
    if [[ $# -lt 1 ]]; then die "Usage: ./notion open <No.>"; fi
    cmd_open "$1"
    ;;
  bootstrap)
    if [[ $# -gt 0 && ( "$1" == "--help" || "$1" == "-h" || "$1" == "help" ) ]]; then
      cmd_bootstrap_help
    else
      cmd_bootstrap
    fi
    ;;
  rules)
    cmd_rules
    ;;
  dbs)
    cmd_dbs
    ;;
  people)
    cmd_people
    ;;
  assign)
    if [[ $# -lt 2 ]]; then die "Usage: notion assign <No.> <handle[,handle,...]>"; fi
    cmd_assign "$1" "$2"
    ;;
  unassign)
    if [[ $# -lt 2 ]]; then die "Usage: notion unassign <No.> <handle[,handle,...]>"; fi
    cmd_unassign "$1" "$2"
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    die "Unknown command: '${COMMAND}'. Run './notion help' for usage."
    ;;
esac
