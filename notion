#!/usr/bin/env bash
# =============================================================================
# ./notion — Notion CLI for task management via Notion API
# =============================================================================
# Usage:
#   ./notion [--db <id|alias>] tasks              List all tasks grouped by Status
#   ./notion [--db <id|alias>] tasks <No.>        Show task details + comments
#   ./notion [--db <id|alias>] tasks --filter <prop> <val>
#   ./notion [--db <id|alias>] tasks --sort <prop> [asc|desc]
#   ./notion [--db <id|alias>] comment <No.> "text"
#   ./notion [--db <id|alias>] update <No.> <property> <value>
#   ./notion [--db <id|alias>] create --title "..." [--prop val]
#   ./notion [--db <id|alias>] open <No.>
#   ./notion dbs                                  List available DB aliases
#   ./notion rules                                Display workspace best practices
#
# --db overrides NOTION_DATABASE_ID for this invocation only.
# Aliases are defined in .env.notion as NOTION_DB_<ALIAS>=<uuid>
# e.g.  NOTION_DB_VENTURES=3da11e67af4180c4...
#       notion --db ventures tasks
# =============================================================================

set -uo pipefail

# ---------------------------------------------------------------------------
# Config — load from .env.notion
# ---------------------------------------------------------------------------
ENV_FILE="${PWD}/.env.notion"

if [[ ! -f "$ENV_FILE" ]]; then
  echo -e "\033[31mERROR:\033[0m .env.notion not found in current directory (${PWD})"
  echo ""
  echo "Create .env.notion with:"
  echo "  NOTION_API_KEY=secret_xxxx       # from notion.so/profile/integrations"
  echo "  NOTION_DATABASE_ID=xxxx          # from board URL: notion.so/.../<THIS_PART>?v=..."
  exit 1
fi

while IFS= read -r _line || [[ -n "$_line" ]]; do
  # strip inline comments and carriage returns
  _line="${_line%%#*}"
  _line="${_line//[$'\r']}"
  [[ -z "${_line// }" ]] && continue
  # split on first '=' only — handles values that contain '=' (e.g. base64 keys)
  _key="${_line%%=*}"
  _val="${_line#*=}"
  # trim whitespace from key and value
  _key="${_key#"${_key%%[![:space:]]*}"}" ; _key="${_key%"${_key##*[![:space:]]}"}"
  _val="${_val#"${_val%%[![:space:]]*}"}" ; _val="${_val%"${_val##*[![:space:]]}"}"
  # strip surrounding quotes from value
  _val="${_val#\"}" ; _val="${_val%\"}"
  _val="${_val#\'}" ; _val="${_val%\'}"
  # Handle NOTION_DATABASE_ID:<ALIAS>=<uuid> — store in associative array, skip export
  if [[ "$_key" =~ ^NOTION_DATABASE_ID:(.+)$ ]]; then
    _alias="${BASH_REMATCH[1],,}"   # lowercase alias
    _NOTION_DB_ALIASES["$_alias"]="$_val"
  elif [[ "$_key" =~ ^NOTION_ ]]; then
    export "$_key"="$_val"
  fi
done < "$ENV_FILE"
unset _line _key _val

NOTION_API_KEY="${NOTION_API_KEY:-}"
NOTION_DATABASE_ID="${NOTION_DATABASE_ID:-}"
NOTION_STATUS_PROPERTY_NAME="Status"
NOTION_TITLE_PROPERTY_NAME="${NOTION_TITLE_PROPERTY_NAME:-Task name}"
NOTION_VERSION="2022-06-28"
BASE_URL="https://api.notion.com/v1"

# Populated during env parsing: alias (lowercase) → uuid
declare -A _NOTION_DB_ALIASES=()

# ---------------------------------------------------------------------------
# Early arg parsing — consume --db <id|alias> before the command name
# ---------------------------------------------------------------------------
_DB_OVERRIDE=""
_REMAINING_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --db)
      [[ $# -lt 2 ]] && { echo -e "\033[31mERROR:\033[0m --db requires an argument" >&2; exit 1; }
      _DB_OVERRIDE="$2"; shift; shift ;;
    *) _REMAINING_ARGS+=("$1"); shift ;;
  esac
done
set -- "${_REMAINING_ARGS[@]+"${_REMAINING_ARGS[@]}"}"
unset _REMAINING_ARGS

# Resolve alias → UUID if --db was given
if [[ -n "$_DB_OVERRIDE" ]]; then
  # Check if it looks like a raw UUID (hex chars and optional hyphens, 32-36 chars)
  if [[ "$_DB_OVERRIDE" =~ ^[0-9a-fA-F-]{32,36}$ ]]; then
    NOTION_DATABASE_ID="$_DB_OVERRIDE"
  else
    # Look up alias (case-insensitive — aliases stored lowercase)
    _alias_lower="${_DB_OVERRIDE,,}"
    _ALIAS_VAL="${_NOTION_DB_ALIASES[$_alias_lower]:-}"
    if [[ -z "$_ALIAS_VAL" ]]; then
      echo -e "\033[31mERROR:\033[0m DB alias '${_DB_OVERRIDE}' not found." >&2
      echo "  Define it in .env.notion as: NOTION_DATABASE_ID:${_DB_OVERRIDE^^}=<uuid>" >&2
      echo "  Run 'notion dbs' to see available aliases." >&2
      exit 1
    fi
    NOTION_DATABASE_ID="$_ALIAS_VAL"
    unset _alias_lower _ALIAS_VAL
  fi
fi
unset _DB_OVERRIDE

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
die()    { echo -e "\033[31mERROR:\033[0m $*" >&2; exit 1; }
info()   { echo -e "\033[36m$*\033[0m"; }
bold()   { echo -e "\033[1m$*\033[0m"; }
dim()    { echo -e "\033[2m$*\033[0m"; }
green()  { echo -e "\033[32m$*\033[0m"; }
yellow() { echo -e "\033[33m$*\033[0m"; }

require_deps() {
  for cmd in curl jq; do
    command -v "$cmd" &>/dev/null || die "'$cmd' is required but not installed."
  done
}

require_env() {
  if [[ -z "$NOTION_API_KEY" ]]; then
    die "NOTION_API_KEY is not set in .env.notion"
  fi
  if [[ -z "$NOTION_DATABASE_ID" ]]; then
    die "NOTION_DATABASE_ID is not set in .env.notion"
  fi
}

# ---------------------------------------------------------------------------
# API call wrapper
# ---------------------------------------------------------------------------
notion_get() {
  local path="$1"
  curl -s \
    -H "Authorization: Bearer ${NOTION_API_KEY}" \
    -H "Notion-Version: ${NOTION_VERSION}" \
    -H "Content-Type: application/json" \
    "${BASE_URL}${path}"
}

notion_post() {
  local path="$1"
  local body="$2"
  if [[ -z "$body" ]]; then body="{}"; fi
  curl -s \
    -X POST \
    -H "Authorization: Bearer ${NOTION_API_KEY}" \
    -H "Notion-Version: ${NOTION_VERSION}" \
    -H "Content-Type: application/json" \
    --data "$body" \
    "${BASE_URL}${path}"
}

notion_patch() {
  local path="$1"
  local body="$2"
  if [[ -z "$body" ]]; then body="{}"; fi
  curl -s \
    -X PATCH \
    -H "Authorization: Bearer ${NOTION_API_KEY}" \
    -H "Notion-Version: ${NOTION_VERSION}" \
    -H "Content-Type: application/json" \
    --data "$body" \
    "${BASE_URL}${path}"
}

# ---------------------------------------------------------------------------
# Resolve No. → page_id via unique_id filter
# ---------------------------------------------------------------------------
resolve_page_id() {
  local no="$1"
  local result
  result=$(notion_post "/databases/${NOTION_DATABASE_ID}/query" \
    "{\"filter\":{\"property\":\"ID\",\"unique_id\":{\"equals\":${no}}}}")

  local page_id
  page_id=$(echo "$result" | jq -r '.results[0].id // empty')
  if [[ -z "$page_id" ]]; then
    die "No task found with No. = ${no}"
  fi
  echo "$page_id"
}

# ---------------------------------------------------------------------------
# Pretty-print a single property value by type
# ---------------------------------------------------------------------------
print_property() {
  local name="$1"
  local prop="$2"
  local type
  type=$(echo "$prop" | jq -r '.type')

  local value=""
  case "$type" in
    title)        value=$(echo "$prop" | jq -r '.title | map(.plain_text) | join("")') ;;
    rich_text)    value=$(echo "$prop" | jq -r '.rich_text | map(.plain_text) | join("")') ;;
    number)       value=$(echo "$prop" | jq -r '.number // ""') ;;
    select)       value=$(echo "$prop" | jq -r '.select.name // ""') ;;
    multi_select) value=$(echo "$prop" | jq -r '[.multi_select[].name] | join(", ")') ;;
    status)       value=$(echo "$prop" | jq -r '.status.name // ""') ;;
    date)         value=$(echo "$prop" | jq -r 'if .date then (.date.start + (if .date.end then " → " + .date.end else "" end)) else "" end') ;;
    checkbox)     value=$(echo "$prop" | jq -r 'if .checkbox then "✓" else "✗" end') ;;
    url)          value=$(echo "$prop" | jq -r '.url // ""') ;;
    email)        value=$(echo "$prop" | jq -r '.email // ""') ;;
    phone_number) value=$(echo "$prop" | jq -r '.phone_number // ""') ;;
    people)       value=$(echo "$prop" | jq -r '[.people[].name // .people[].id] | join(", ")') ;;
    relation)     value=$(echo "$prop" | jq -r '[.relation[].id] | join(", ")') ;;
    unique_id)    value=$(echo "$prop" | jq -r '(.unique_id.prefix // "") + (.unique_id.number | tostring)') ;;
    created_time) value=$(echo "$prop" | jq -r '.created_time // ""') ;;
    last_edited_time) value=$(echo "$prop" | jq -r '.last_edited_time // ""') ;;
    created_by)   value=$(echo "$prop" | jq -r '.created_by.name // .created_by.id // ""') ;;
    last_edited_by) value=$(echo "$prop" | jq -r '.last_edited_by.name // .last_edited_by.id // ""') ;;
    files)        value=$(echo "$prop" | jq -r '[.files[].name] | join(", ")') ;;
    *)            value="[type: $type]" ;;
  esac

  printf "  \033[1m%-25s\033[0m %s\n" "${name}:" "$value"
}

# ---------------------------------------------------------------------------
# Shared helper: resolve comma-separated handles → JSON array of people objects
# Usage: resolve_emails "waqas@example.com,syed@example.com"
# Result is written to global _RESOLVED_PEOPLE (JSON array of people objects).
# Dies on unknown email. Calling code reads $_RESOLVED_PEOPLE directly — no subshell needed.
# ---------------------------------------------------------------------------
_RESOLVED_PEOPLE=""

resolve_emails() {
  local input="$1"
  local users_json
  users_json=$(notion_get "/users")

  local err
  err=$(echo "$users_json" | jq -r '.object // ""')
  if [[ "$err" == "error" ]]; then
    die "Failed to fetch users: $(echo "$users_json" | jq -r '.message // "unknown error"')"
  fi

  # Build a map: lowercase_email → id  (persons only)
  local user_map
  user_map=$(echo "$users_json" | jq '[
    .results[]
    | select(.type == "person")
    | {
        email: (.person.email | ascii_downcase),
        id:    .id
      }
  ]')

  local valid_emails
  valid_emails=$(echo "$user_map" | jq -r '.[].email' | sort | tr '\n' ' ')

  # Split input on commas, resolve each email
  local people_array="[]"
  IFS=',' read -ra raw_inputs <<< "$input"
  for raw in "${raw_inputs[@]}"; do
    # trim whitespace
    local email
    email="${raw#"${raw%%[![:space:]]*}"}"
    email="${email%"${email##*[![:space:]]}"}"
    email="${email,,}"   # lowercase for case-insensitive match

    local uid
    uid=$(echo "$user_map" | jq -r --arg e "$email" \
      '.[] | select(.email == $e) | .id' | head -1)

    if [[ -z "$uid" ]]; then
      die "Unknown email '${email}'. Valid emails: ${valid_emails% }"
    fi

    people_array=$(echo "$people_array" | jq \
      --arg id "$uid" \
      '. + [{"object":"user","id":$id}]')
  done

  _RESOLVED_PEOPLE="$people_array"
}

# ---------------------------------------------------------------------------
# Shared helper: resolve a single email (or UUID) → user_id
# Used by filter logic. Passes UUIDs through unchanged.
# ---------------------------------------------------------------------------
resolve_handle_to_id() {
  local input="$1"
  # If it already looks like a UUID, return as-is
  if [[ "$input" =~ ^[0-9a-fA-F-]{32,36}$ ]]; then
    echo "$input"
    return
  fi

  local users_json
  users_json=$(notion_get "/users")

  local err
  err=$(echo "$users_json" | jq -r '.object // ""')
  if [[ "$err" == "error" ]]; then
    die "Failed to fetch users: $(echo "$users_json" | jq -r '.message // "unknown error"')"
  fi

  local email_lower="${input,,}"
  local uid
  uid=$(echo "$users_json" | jq -r --arg e "$email_lower" '
    .results[]
    | select(.type == "person")
    | select((.person.email | ascii_downcase) == $e)
    | .id
  ' | head -1)

  if [[ -z "$uid" ]]; then
    local valid
    valid=$(echo "$users_json" | jq -r \
      '[.results[] | select(.type=="person") | .person.email | ascii_downcase] | sort | join(", ")')
    die "Unknown email '${input}'. Valid emails: ${valid}"
  fi

  echo "$uid"
}

# ---------------------------------------------------------------------------
# cmd: people — list all workspace members
# ---------------------------------------------------------------------------
cmd_people() {
  info "Fetching workspace members..."
  local users_json
  users_json=$(notion_get "/users")

  local err
  err=$(echo "$users_json" | jq -r '.object // ""')
  if [[ "$err" == "error" ]]; then
    die "Failed to fetch users: $(echo "$users_json" | jq -r '.message // "unknown error"')"
  fi

  echo ""
  echo "$users_json" | jq -r '.results[] |
    [
      (.name // "" | split(" ") | .[0] | ascii_downcase | .[0:14]),
      (if .type == "bot"
        then "[bot]"
        else (.person.email // "—")
       end | .[0:36]),
      .id
    ] |
    @tsv' | \
  while IFS=$'\t' read -r handle email uid; do
    printf "  \033[1m%-14s\033[0m  \033[2m%-36s\033[0m  %s\n" "$handle" "$email" "$uid"
  done
  echo ""
}

# ---------------------------------------------------------------------------
# cmd: assign <No.> <handle[,handle,...]> — set assignees (replaces all)
# ---------------------------------------------------------------------------
cmd_assign() {
  local no="$1"
  local handles_input="$2"

  if [[ -z "$handles_input" ]]; then
    die "Usage: notion assign <No.> <handle[,handle,...]>"
  fi

  info "Resolving emails..."
  resolve_emails "$handles_input"
  local people_array="$_RESOLVED_PEOPLE"

  info "Fetching task No. ${no}..."
  local page_id
  page_id=$(resolve_page_id "$no")

  # Find the people property name on this page (prefer "Assigned To", fall back to first people prop)
  local page
  page=$(notion_get "/pages/${page_id}")
  local prop_name
  prop_name=$(echo "$page" | jq -r '
    .properties | to_entries[]
    | select(.value.type == "people")
    | .key
  ' | head -1)

  if [[ -z "$prop_name" ]]; then
    die "No 'people' property found on task No. ${no}."
  fi

  local body
  body=$(jq -n \
    --arg p "$prop_name" \
    --argjson arr "$people_array" \
    '{properties: {($p): {people: $arr}}}')

  notion_patch "/pages/${page_id}" "$body" > /dev/null
  local display
  display=$(echo "$people_array" | jq -r '[.[].id] | join(", ")')
  green "✓ Assigned '${prop_name}' on task No. ${no} → ${handles_input}"
}

# ---------------------------------------------------------------------------
# cmd: unassign <No.> <handle[,handle,...]> — remove specific assignees
# ---------------------------------------------------------------------------
cmd_unassign() {
  local no="$1"
  local handles_input="$2"

  if [[ -z "$handles_input" ]]; then
    die "Usage: notion unassign <No.> <handle[,handle,...]>"
  fi

  info "Fetching task No. ${no}..."
  local page_id
  page_id=$(resolve_page_id "$no")

  local page
  page=$(notion_get "/pages/${page_id}")

  local prop_name
  prop_name=$(echo "$page" | jq -r '
    .properties | to_entries[]
    | select(.value.type == "people")
    | .key
  ' | head -1)

  if [[ -z "$prop_name" ]]; then
    die "No 'people' property found on task No. ${no}."
  fi

  # Fetch users to resolve emails → IDs
  local users_json
  users_json=$(notion_get "/users")

  # Build set of IDs to remove
  local remove_ids="[]"
  IFS=',' read -ra raw_inputs <<< "$handles_input"
  for raw in "${raw_inputs[@]}"; do
    local email
    email="${raw#"${raw%%[![:space:]]*}"}"
    email="${email%"${email##*[![:space:]]}"}"
    email="${email,,}"

    local uid
    uid=$(echo "$users_json" | jq -r --arg e "$email" '
      .results[]
      | select(.type == "person")
      | select((.person.email | ascii_downcase) == $e)
      | .id
    ' | head -1)

    if [[ -z "$uid" ]]; then
      local valid
      valid=$(echo "$users_json" | jq -r \
        '[.results[] | select(.type=="person") | .person.email | ascii_downcase] | sort | join(", ")')
      die "Unknown email '${email}'. Valid emails: ${valid}"
    fi

    # Check if this person is currently assigned
    local currently_assigned
    currently_assigned=$(echo "$page" | jq -r \
      --arg p "$prop_name" --arg id "$uid" \
      '.properties[$p].people[]? | select(.id == $id) | .id')

    if [[ -z "$currently_assigned" ]]; then
      yellow "Warning: '${handle}' is not currently assigned to task No. ${no}, skipping."
      continue
    fi

    remove_ids=$(echo "$remove_ids" | jq --arg id "$uid" '. + [$id]')
  done

  # Build new assignees array: current minus removed
  local new_people
  new_people=$(echo "$page" | jq \
    --arg p "$prop_name" \
    --argjson rm "$remove_ids" \
    '.properties[$p].people | map(select(.id as $id | $rm | index($id) == null)) | map({object:"user",id:.id})')

  local body
  body=$(jq -n \
    --arg p "$prop_name" \
    --argjson arr "$new_people" \
    '{properties: {($p): {people: $arr}}}')

  notion_patch "/pages/${page_id}" "$body" > /dev/null
  green "✓ Unassigned [${handles_input}] from task No. ${no}"
}

# ---------------------------------------------------------------------------
# cmd: tasks list — grouped by Stage
# ---------------------------------------------------------------------------
cmd_tasks_list() {
  local filter_prop="" filter_val="" sort_prop="" sort_dir="ascending"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --filter) filter_prop="$2"; filter_val="$3"; shift; shift; shift ;;
      --sort)
        sort_prop="$2"; shift; shift
        if [[ $# -gt 0 && "$1" =~ ^(asc|desc|ascending|descending)$ ]]; then
          sort_dir="$1"; shift
        fi
        ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  [[ "$sort_dir" == "asc" ]]  && sort_dir="ascending"
  [[ "$sort_dir" == "desc" ]] && sort_dir="descending"

  local body="{}"

  if [[ -n "$filter_prop" && -n "$filter_val" ]]; then
    # Detect property type from the database schema to pick the right filter shape
    local schema
    schema=$(notion_get "/databases/${NOTION_DATABASE_ID}")

    local prop_type_for_filter=""
    prop_type_for_filter=$(echo "$schema" | jq -r --arg p "$filter_prop" '
      .properties | to_entries[]
      | select((.key | ascii_downcase) == ($p | ascii_downcase))
      | .value.type
    ' | head -1)

    if [[ "$prop_type_for_filter" == "people" ]]; then
      # Resolve handle → user ID, then use people filter
      info "Resolving handle '${filter_val}' for people filter..."
      local uid
      uid=$(resolve_handle_to_id "$filter_val")
      local real_prop_name
      real_prop_name=$(echo "$schema" | jq -r --arg p "$filter_prop" '
        .properties | to_entries[]
        | select((.key | ascii_downcase) == ($p | ascii_downcase))
        | .key
      ' | head -1)
      body=$(jq -n \
        --arg prop "${real_prop_name:-$filter_prop}" \
        --arg uid "$uid" \
        '{filter: {property: $prop, people: {contains: $uid}}}')

    elif [[ "$prop_type_for_filter" == "created_by" ]]; then
      # Resolve handle → user ID, use created_by filter
      info "Resolving handle '${filter_val}' for created_by filter..."
      local uid
      uid=$(resolve_handle_to_id "$filter_val")
      local real_prop_name
      real_prop_name=$(echo "$schema" | jq -r --arg p "$filter_prop" '
        .properties | to_entries[]
        | select((.key | ascii_downcase) == ($p | ascii_downcase))
        | .key
      ' | head -1)
      body=$(jq -n \
        --arg prop "${real_prop_name:-$filter_prop}" \
        --arg uid "$uid" \
        '{filter: {property: $prop, created_by: {contains: $uid}}}')

    else
      # Default: OR across common text/select/status/multi_select types
      body=$(jq -n \
        --arg prop "$filter_prop" \
        --arg val "$filter_val" \
        '{filter: {or: [
            {property: $prop, rich_text:    {contains: $val}},
            {property: $prop, select:       {equals:   $val}},
            {property: $prop, status:       {equals:   $val}},
            {property: $prop, multi_select: {contains: $val}}
          ]}}')
    fi
  fi

  if [[ -n "$sort_prop" ]]; then
    body=$(echo "$body" | jq \
      --arg prop "$sort_prop" \
      --arg dir "$sort_dir" \
      '. + {sorts: [{property: $prop, direction: $dir}]}')
  else
    # default: sort by last edited, most recent first
    body=$(echo "$body" | jq '. + {sorts: [{timestamp: "last_edited_time", direction: "descending"}]}')
  fi

  info "Fetching tasks..."
  local result
  result=$(notion_post "/databases/${NOTION_DATABASE_ID}/query" "$body")

  local count
  count=$(echo "$result" | jq '.results | length')

  if [[ "$count" -eq 0 ]]; then
    yellow "No tasks found."
    return
  fi

  # Collect unique group-by values
  local statuses
  statuses=$(echo "$result" | jq -r --arg grp "$NOTION_STATUS_PROPERTY_NAME" '
    [ .results[].properties
      | to_entries[]
      | select(.key == $grp)
      | .value
      | if   .type == "status" then .status.name
        elif .type == "select"  then .select.name
        else null end
      | select(. != null)
    ] | unique | .[]
  ')

  if [[ -z "$statuses" ]]; then
    yellow "No '${NOTION_STATUS_PROPERTY_NAME}' property found — listing flat:"
    echo "$result" | jq -r '
      .results[] |
      "  No." +
      (.properties | to_entries[] | select(.value.type=="unique_id") | .value.unique_id.number | tostring) +
      "  " +
      (.properties | to_entries[] | select(.value.type=="title") | .value.title | map(.plain_text) | join("") | if length > 80 then .[0:80] + "..." else . end)'
    return
  fi

  # Print each stage group
  while IFS= read -r status; do
    [[ -z "$status" ]] && continue
    local group
    group=$(echo "$result" | jq -r --arg s "$status" --arg grp "$NOTION_STATUS_PROPERTY_NAME" '
      .results[]
      | select(
          (.properties | to_entries[] | select(.key==$grp) | .value
            | if   .type=="status" then .status.name
              elif .type=="select"  then .select.name
              else "" end
          ) == $s
        )
      | "  No." +
        (.properties | to_entries[] | select(.value.type=="unique_id") | .value.unique_id.number | tostring) +
        "  " +
        (.properties | to_entries[] | select(.value.type=="title") | .value.title | map(.plain_text) | join("") | if length > 80 then .[0:80] + "..." else . end)
    ')
    if [[ -n "$group" ]]; then
      echo ""
      bold "── $status ──────────────────────────────────────"
      echo "$group"
    fi
  done <<< "$statuses"

  # Tasks with no group-by value set
  local no_stage
  no_stage=$(echo "$result" | jq -r --arg grp "$NOTION_STATUS_PROPERTY_NAME" '
    .results[]
    | select(
        (.properties | to_entries[] | select(.key==$grp) | .value
          | if   .type=="status" then .status.name
            elif .type=="select"  then .select.name
            else null end
        ) == null
      )
    | "  No." +
      (.properties | to_entries[] | select(.value.type=="unique_id") | .value.unique_id.number | tostring) +
      "  " +
      (.properties | to_entries[] | select(.value.type=="title") | .value.title | map(.plain_text) | join("") | if length > 80 then .[0:80] + "..." else . end)
  ' 2>/dev/null || true)

  if [[ -n "$no_stage" ]]; then
    echo ""
    bold "── (no stage) ──────────────────────────────────"
    echo "$no_stage"
  fi

  echo ""
  dim "Total: $count tasks"
}

# ---------------------------------------------------------------------------
# cmd: tasks <No.> — show details + comments
# ---------------------------------------------------------------------------
cmd_task_detail() {
  local no="$1"
  info "Fetching task No. ${no}..."

  local page_id
  page_id=$(resolve_page_id "$no")

  local page
  page=$(notion_get "/pages/${page_id}")

  echo ""
  bold "══════════════════════════════════════════════════"
  bold " Task No. ${no}"
  bold "══════════════════════════════════════════════════"
  echo ""
  bold "Properties:"

  echo "$page" | jq -c '.properties | to_entries[]' | while IFS= read -r entry; do
    local name val
    name=$(echo "$entry" | jq -r '.key')
    val=$(echo "$entry"  | jq -c '.value')
    print_property "$name" "$val"
  done

  local url
  url=$(echo "$page" | jq -r '.url // ""')
  echo ""
  dim "  URL: $url"

  echo ""
  bold "Comments:"
  local comments
  comments=$(notion_get "/comments?block_id=${page_id}")
  local comment_count
  comment_count=$(echo "$comments" | jq '.results | length')

  if [[ "$comment_count" -eq 0 ]]; then
    dim "  (no comments)"
  else
    echo "$comments" | jq -r '.results[] |
      "  [" + .created_time[0:10] + "] " +
      (.created_by.name // "Unknown") + ": " +
      (.rich_text | map(.plain_text) | join(""))'
  fi
  echo ""
}

# ---------------------------------------------------------------------------
# cmd: comment <No.> "text"
# ---------------------------------------------------------------------------
cmd_add_comment() {
  local no="$1"
  local text="$2"
  if [[ -z "$text" ]]; then
    die "Comment text cannot be empty."
  fi

  info "Fetching task No. ${no}..."
  local page_id
  page_id=$(resolve_page_id "$no")

  # Build a rich_text array that renders URLs as clickable links.
  # Strategy: split the text on URLs, emit plain-text segments and link
  # segments alternately, then combine into a JSON array with jq.
  local rich_text_json
  rich_text_json=$(python3 -c "
import re, json, sys

text = sys.argv[1]
url_re = re.compile(r'(https?://[^\s]+)')
parts = url_re.split(text)
segments = []
for part in parts:
    if not part:
        continue
    if url_re.match(part):
        segments.append({
            'type': 'text',
            'text': {'content': part, 'link': {'url': part}}
        })
    else:
        segments.append({
            'type': 'text',
            'text': {'content': part}
        })
print(json.dumps(segments))
" "$text")

  local body
  body=$(jq -n \
    --arg pid "$page_id" \
    --argjson rt "$rich_text_json" \
    '{parent: {page_id: $pid}, rich_text: $rt}')

  local result
  result=$(notion_post "/comments" "$body")
  local cid
  cid=$(echo "$result" | jq -r '.id')
  green "✓ Comment added to task No. ${no} (id: ${cid})"
}

# ---------------------------------------------------------------------------
# cmd: update <No.> <property> <value>
# ---------------------------------------------------------------------------
cmd_update() {
  local no="$1"
  local prop="$2"
  local value="$3"

  info "Fetching task No. ${no}..."
  local page_id
  page_id=$(resolve_page_id "$no")

  local page
  page=$(notion_get "/pages/${page_id}")

  # Case-insensitive property name match
  local real_prop
  real_prop=$(echo "$page" | jq -r --arg p "$prop" '
    .properties | to_entries[]
    | select((.key | ascii_downcase) == ($p | ascii_downcase))
    | .key
  ' | head -1)

  if [[ -z "$real_prop" ]]; then
    die "Property '${prop}' not found on task No. ${no}."
  fi

  local prop_type
  prop_type=$(echo "$page" | jq -r --arg p "$real_prop" '.properties[$p].type')

  local prop_body
  case "$prop_type" in
    title)        prop_body=$(jq -n --arg v "$value" '{title:     [{type:"text",text:{content:$v}}]}') ;;
    rich_text)    prop_body=$(jq -n --arg v "$value" '{rich_text: [{type:"text",text:{content:$v}}]}') ;;
    select)       prop_body=$(jq -n --arg v "$value" '{select:       {name:$v}}') ;;
    status)       prop_body=$(jq -n --arg v "$value" '{status:       {name:$v}}') ;;
    multi_select) prop_body=$(jq -n --arg v "$value" '{multi_select: ($v | split(",") | map(ltrimstr(" ") | rtrimstr(" ")) | map({name:.}))}') ;;
    number)       prop_body=$(jq -n --argjson v "$value" '{number: $v}') ;;
    checkbox)
      local bv="false"
      if [[ "$value" == "true" || "$value" == "1" || "$value" == "yes" ]]; then bv="true"; fi
      prop_body=$(jq -n --argjson v "$bv" '{checkbox: $v}') ;;
    url)          prop_body=$(jq -n --arg v "$value" '{url:          $v}') ;;
    email)        prop_body=$(jq -n --arg v "$value" '{email:        $v}') ;;
    phone_number) prop_body=$(jq -n --arg v "$value" '{phone_number: $v}') ;;
    date)         prop_body=$(jq -n --arg v "$value" '{date: {start: $v}}') ;;
    people)
      resolve_emails "$value"
      local people_arr="$_RESOLVED_PEOPLE"
      prop_body=$(jq -n --argjson arr "$people_arr" '{people: $arr}') ;;
    *)            die "Property type '${prop_type}' is not supported for update via CLI." ;;
  esac

  local body
  body=$(jq -n --arg p "$real_prop" --argjson pb "$prop_body" '{properties: {($p): $pb}}')

  notion_patch "/pages/${page_id}" "$body" > /dev/null
  green "✓ Updated '${real_prop}' on task No. ${no} → ${value}"
}

# ---------------------------------------------------------------------------
# cmd: create --title "..." [--<prop> <val> ...]
# ---------------------------------------------------------------------------
cmd_create() {
  local title=""
  declare -A extra_props

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="$2"; shift; shift ;;
      --*)
        local key="${1#--}"
        extra_props["$key"]="$2"
        shift; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done

  if [[ -z "$title" ]]; then
    die "You must provide --title \"...\" to create a task."
  fi

  local props
  props=$(jq -n --arg t "$title" --arg tprop "$NOTION_TITLE_PROPERTY_NAME" '{($tprop): {title: [{type:"text",text:{content:$t}}]}}')

  if [[ ${#extra_props[@]} -gt 0 ]]; then
    local schema
    schema=$(notion_get "/databases/${NOTION_DATABASE_ID}")

    for key in "${!extra_props[@]}"; do
      local val="${extra_props[$key]}"

      local real_key
      real_key=$(echo "$schema" | jq -r --arg k "$key" '
        .properties | to_entries[]
        | select((.key | ascii_downcase) == ($k | ascii_downcase))
        | .key
      ' | head -1)

      if [[ -z "$real_key" ]]; then
        yellow "Warning: property '${key}' not found in schema, skipping."
        continue
      fi

      local ptype
      ptype=$(echo "$schema" | jq -r --arg k "$real_key" '.properties[$k].type')

      local patch
      case "$ptype" in
        rich_text)    patch=$(jq -n --arg v "$val" '{rich_text: [{type:"text",text:{content:$v}}]}') ;;
        select)       patch=$(jq -n --arg v "$val" '{select: {name:$v}}') ;;
        status)       patch=$(jq -n --arg v "$val" '{status: {name:$v}}') ;;
        multi_select) patch=$(jq -n --arg v "$val" '{multi_select: ($v | split(",") | map(ltrimstr(" ") | rtrimstr(" ")) | map({name:.}))}') ;;
        number)       patch=$(jq -n --argjson v "$val" '{number: $v}') ;;
        checkbox)
          local bv="false"
          if [[ "$val" == "true" || "$val" == "1" ]]; then bv="true"; fi
          patch=$(jq -n --argjson v "$bv" '{checkbox: $v}') ;;
        url)          patch=$(jq -n --arg v "$val" '{url: $v}') ;;
        date)         patch=$(jq -n --arg v "$val" '{date: {start:$v}}') ;;
        *)            yellow "Warning: type '$ptype' for '$key' not supported, skipping."; continue ;;
      esac
      props=$(echo "$props" | jq --arg k "$real_key" --argjson p "$patch" '.[$k] = $p')
    done
  fi

  local body
  body=$(jq -n \
    --arg db "$NOTION_DATABASE_ID" \
    --argjson props "$props" \
    '{parent: {database_id: $db}, properties: $props}')

  local result
  result=$(notion_post "/pages" "$body")

  local new_id
  new_id=$(echo "$result" | jq -r '
    .properties | to_entries[]
    | select(.value.type=="unique_id")
    | .value.unique_id.number | tostring
  ')
  local url
  url=$(echo "$result" | jq -r '.url')

  green "✓ Task created!"
  if [[ -n "$new_id" ]]; then echo "  No.  : $new_id"; fi
  echo "  URL  : $url"
}

# ---------------------------------------------------------------------------
# cmd: bootstrap — provision the database with standard task management properties
# ---------------------------------------------------------------------------
cmd_bootstrap() {
  info "Bootstrapping database ${NOTION_DATABASE_ID}..."

  # -------------------------------------------------------------------
  # Template: properties to create/update on the database
  # PATCH /databases merges, so existing properties are preserved.
  # -------------------------------------------------------------------
  local props
  props=$(jq -n '{
    "ID": {
      "unique_id": {
        "prefix": null
      }
    },
    "Status": {
      "status": {
        "options": [
          {"name": "Triage"},
          {"name": "Backlog"},
          {"name": "Up Next"},
          {"name": "In Progress"},
          {"name": "In Review"},
          {"name": "In QA"},
          {"name": "Ready to Deploy"},
          {"name": "UAT"},
          {"name": "Completed"},
          {"name": "Cancelled"}
        ],
        "groups": [
          {
            "name": "Not started",
            "color": "gray",
            "option_ids": []
          },
          {
            "name": "In progress",
            "color": "blue",
            "option_ids": []
          },
          {
            "name": "Complete",
            "color": "green",
            "option_ids": []
          }
        ]
      }
    },
    "Priority": {
      "select": {
        "options": [
          {"name": "🔴 Critical"},
          {"name": "🟠 High"},
          {"name": "🟡 Medium"},
          {"name": "🟢 Low"}
        ]
      }
    },
    "Assignee": {
      "people": {}
    },
    "Due Date": {
      "date": {}
    },
    "Tags": {
      "multi_select": {
        "options": [
          {"name": "issue persists"},
          {"name": "reviewed"},
          {"name": "on hold"},
          {"name": "awaiting details"},
          {"name": "cancelled"},
          {"name": "has-migration"},
          {"name": "has-env-change"}
        ]
      }
    },
    "Notes": {
      "rich_text": {}
    },
    "URL": {
      "url": {}
    },
    "Effort": {
      "number": {
        "format": "number"
      }
    },
    "Git Branch": {
      "rich_text": {}
    }
  }')

  local body
  body=$(jq -n --argjson props "$props" '{properties: $props}')

  local result
  result=$(notion_patch "/databases/${NOTION_DATABASE_ID}" "$body")

  local err
  err=$(echo "$result" | jq -r '.object // ""')

  if [[ "$err" == "error" ]]; then
    local msg
    msg=$(echo "$result" | jq -r '.message // "Unknown error"')
    die "Bootstrap failed: $msg"
  fi

  green "✓ Database bootstrapped successfully!"
  echo ""
  bold "Properties configured:"
  echo "$result" | jq -r '.properties | to_entries[] | "  • \(.key)  [\(.value.type)]"'
  echo ""
  local clean_id
  clean_id="${NOTION_DATABASE_ID//-/}"
  dim "  URL: https://www.notion.so/${clean_id}"
}

