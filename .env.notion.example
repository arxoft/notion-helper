NOTION_API_KEY=                          # ntn_xxxx — from notion.so/profile/integrations
NOTION_DATABASE_ID=                      # default database — from board URL: notion.so/.../<ID>?v=...
NOTION_DATABASE_ID:VENTURES=             # optional alias: notion --db ventures
NOTION_DATABASE_ID:CLIENTS=              # optional alias: notion --db clients
NOTION_TITLE_PROPERTY_NAME=Title         # name of the title property in your database (default: "Title")
